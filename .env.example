# Kopier denne fila til .env.local og fyll inn verdiene.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://din-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=din-service-role-key

# --- HubSpot (privat app med scope crm.objects.contacts.read) ---
# Valgfritt: uten et gyldig token feiler kun sync-jobben, resten virker.
HUBSPOT_ACCESS_TOKEN=din-hubspot-token

# --- Cron ---
# Generer med: openssl rand -base64 32
# Vercel setter automatisk Authorization: Bearer $CRON_SECRET på cron-kall.
CRON_SECRET=din-cron-secret

# --- Demo-modus ---
# 1 = kjør mot in-memory testdata uten Supabase (fast passord demo1234 for alle).
# Sett til 0 eller fjern linja for å bruke ekte Supabase.
# Hardkoblet av i produksjonsbygg uansett.
DEMO_MOCK=0

# --- E-post (Resend, for oppfølgingspåminnelser) ---
# Uten disse hoppes e-post over (app-varsler virker uansett).
RESEND_API_KEY=re_din_nokkel
RESEND_FROM=Feelm Leads <varsler@feelm.no>
NEXT_PUBLIC_APP_URL=https://feelmsalgcrm.vercel.app
